{
  "name": "@spec-driven-methodology/mcp",
  "version": "1.3.0",
  "description": "SDM MCP server (stdio) — same domain ops as CLI",
  "type": "module",
  "bin": {
    "sdm-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@spec-driven-methodology/core": "*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "Apache-2.0"
}
