          "widget": "multi",
          "label": "Типы вопросов",
          "options": [
            { "label": "single choice", "value": "single_choice" },
            { "label": "multi choice", "value": "multi_choice" },
            { "label": "open", "value": "open" },
            { "label": "code", "value": "code" }
          ],
          "defaultValue": ["single_choice", "multi_choice"]
        },
        {
          "id": "adaptive",
          "widget": "boolean",
          "label": "Адаптивная выборка",
          "defaultValue": false
        },
        {
          "id": "perSkill",
          "widget": "number",
          "label": "Вопросов на навык (adaptive)",
          "min": 1,
          "max": 20,
          "defaultValue": 3
        },
        {
          "id": "seed",
          "widget": "number",
          "label": "Seed",
          "defaultValue": 42
        },
        {
          "id": "shuffleOptions",
          "widget": "boolean",
          "label": "Перетасовать варианты",
          "defaultValue": false
        }
      ]
    }
