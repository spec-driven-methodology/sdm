        {
          "id": "typescript-core",
          "name": "TypeScript Core",
          "status": "ok",
          "questionCount": 5,
          "depthRatio": 1
        }
      ],
      "suggestions": [
        {
          "id": "close-gaps",
          "label": "Закрыть пробелы покрытия (не покрыто / слабо покрыто)",
          "why": "Демо: missing=1, thin=1",
          "levers": [
            {
              "phrase": "сгенерировать черновики",
              "mapsTo": "question generate --to-skill <skill> --json"
